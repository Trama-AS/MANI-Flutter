    {
      "name": "03 caso 3 — escritura en tenant ajeno",
      "description": "Esperado: rechazada por RLS. Se actua sobre documento_kyc, cuyas filas siembra CFG-12: si el aislamiento estuviera roto, el daño se limita a datos propios.\n\nCon Prefer: return=representation, PostgREST devuelve las filas afectadas. Un array vacio significa 0 filas modificadas, que es lo que RLS debe producir.",
      "item": [
        {
          "name": "negativo: modificar el KYC del tenant 2 con token del tenant 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('0 filas afectadas o 403', () => {",
                  "  if (pm.response.code < 300) pm.expect(pm.response.json()).to.have.lengthOf(0);",
                  "  else pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_t1}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": "{{base_url}}/rest/v1/documento_kyc?id=eq.{{kyc_t2}}",
            "body": {
              "mode": "raw",
              "raw": "{\"estado\":\"comprometido-por-tenant-1\"}"
            }
          }
        },
        {
          "name": "verificar que el KYC del tenant 2 sigue intacto",
          "description": "Se comprueba CON EL TOKEN DEL TENANT 2. Que el atacante no vea el cambio no prueba que no haya ocurrido: hay que mirarlo desde el lado del dueño.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const f = pm.response.json();",
                  "pm.test('la fila existe', () => pm.expect(f).to.have.lengthOf(1));",
                  "pm.test('su estado NO fue modificado', () => pm.expect(f[0].estado).to.eql('aprobado'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_t2}}"
              }
            ],
            "url": "{{base_url}}/rest/v1/documento_kyc?select=id,estado&id=eq.{{kyc_t2}}"
          }
        },
        {
          "name": "POSITIVO: modificar su propio KYC",
          "description": "Restaura el valor al final, para que la suite sea idempotente.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('modifica 1 fila propia', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "  if (pm.response.code === 200) pm.expect(pm.response.json()).to.have.lengthOf(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_t1}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": "{{base_url}}/rest/v1/documento_kyc?id=eq.{{kyc_t1}}",
            "body": {
              "mode": "raw",
              "raw": "{\"estado\":\"aprobado\"}"
            }
          }
        }
      ]
    },
    {
