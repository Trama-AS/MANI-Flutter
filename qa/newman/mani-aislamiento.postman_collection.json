              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ve exactamente su fila', () => {",
                  "  const f = pm.response.json();",
                  "  pm.expect(f).to.have.lengthOf(1);",
                  "  pm.expect(f[0].tenant_id).to.eql(pm.collectionVariables.get('tenant_id_t1'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_t1}}"
              }
            ],
            "url": "{{base_url}}/rest/v1/sitio?select=id,tenant_id&id=eq.{{sitio_id_t1}}"
          }
        }
      ]
    },
