          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rechazada: WITH CHECK aplica', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([401, 403, 404, 400]);",
                  "});",
                  "pm.test('el cuerpo no devuelve una fila creada', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(Array.isArray(b) ? b.length : 0).to.eql(0);",
                  "});"
