                  "  let n = 0;",
                  "  try { const b = pm.response.json(); n = Array.isArray(b) ? b.length : 0; } catch (e) { n = 0; }",
                  "  if (n > 0) {",
                  "    console.log('AVISO: hay ' + n + ' bucket(s). ADR-0013 ya no esta sin implementar: escribir el caso 6 real.');",
                  "  }",
                  "  pm.expect(n, \"si esto falla, es una buena noticia: ya hay Storage que aislar\").to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
